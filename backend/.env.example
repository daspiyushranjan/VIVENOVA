# DeskPilot Environment Variables

# Supabase PostgreSQL Database Connection URL
# Choose ONE of the connection formats below from your Supabase Dashboard:
# (Go to Project Settings -> Database -> Connection string -> URI)

# Option A: Direct Connection (Session mode, default port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Option B: Connection Pooler (Transaction mode, port 6543, recommended for serverless / scale)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Security & Access Control
API_KEY=deskpilot-hackathon-agent-key
REQUIRE_API_KEY=false

# CORS (comma-separated origins or * for all)
CORS_ORIGINS=*
